{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "org.evorule.golden.domain",
  "version": "1.0.0",
  "metadata": {
    "title": "golden domain invalid",
    "description": "[CON-R-004] 金样例（invalid）：eq 域缺必填 value（allOf if/then required 拒绝）",
    "authors": [
      "evorulelab@gmail.com"
    ],
    "license": "CC0-1.0"
  },
  "transform": [
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "eq",
          "path": "player.score"
        },
        "on_true": [
          {
            "type": "set",
            "params": {
              "attr": "meta.hit",
              "operation": "set",
              "value": 1
            }
          }
        ]
      }
    }
  ]
}
