{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "org.evorule.golden.path",
  "version": "1.0.0",
  "metadata": {
    "title": "golden path valid",
    "description": "[CON-R-004] 金样例（valid）：path 含索引段 items[0].meta.name",
    "authors": [
      "evorulelab@gmail.com"
    ],
    "license": "CC0-1.0"
  },
  "transform": [
    {
      "type": "set",
      "params": {
        "attr": "meta.seen",
        "operation": "set",
        "value": true
      }
    },
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "eq",
          "path": "items[0].meta.name",
          "value": "probe"
        },
        "on_true": [
          {
            "type": "set",
            "params": {
              "attr": "meta.hit",
              "operation": "set",
              "value": 1
            }
          }
        ]
      }
    }
  ]
}
