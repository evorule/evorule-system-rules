                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.input_snapshot",
                        "operation": "set",
                        "value": "__exec__.instruction.params"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.timestamp",
