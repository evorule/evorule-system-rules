      "entry_id": "rule-compute-ik",
      "rule_body": [
        {
          "params": {
            "domain": {
              "instruction_type": "compute_ik",
              "type": "instruction"
            },
            "on_true": [
              {
                "params": {
                  "domain": {
                    "path": "__exec__.payload.__io_results__.call_service",
