    {
      "entry_id": "rule-evolution-scanner",
      "rule_body": [
        {
          "params": {
            "domain": {
              "instruction_type": "evolution_scanner",
              "type": "instruction"
            },
            "on_true": [
              {
                "params": {
                  "attr": "audit.failure_count",
                  "operation": "add",
                  "value": "__exec__.instruction.params.inc"
                },
                "type": "set"
              },
              {
                "params": {
                  "domain": {
                    "inner": {
                      "path": "payload.audit.failure_count",
                      "type": "lt",
                      "value": 3
                    },
                    "type": "not"
                  },
                  "on_false": [],
                  "on_true": [
                    {
                      "params": {
                        "attr": "audit.evolve_request.reason",
                        "operation": "set",
                        "value": "连续3次残差超标"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.evolve_request.context",
                        "operation": "set",
                        "value": "__exec__.payload.audit.compacted_log"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.evolve_request.target_rule",
                        "operation": "set",
                        "value": "__exec__.instruction.params.target_rule_type"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.failure_count",
                        "operation": "set",
                        "value": 0
                      },
                      "type": "set"
                    }
                  ]
                },
                "type": "branch"
              }
            ]
          },
          "type": "branch"
        }
      ],
      "provenance": {
        "source": "API 收录"
      },
      "domain": "robot",
      "tags": [
        "yuanze",
        "robot"
      ]
    },
    {
      "entry_id": "rule-generate-patch",
      "rule_body": [
        {
          "params": {
            "domain": {
              "instruction_type": "generate_patch",
              "type": "instruction"
            },
            "on_true": [
              {
                "params": {
                  "domain": {
                    "path": "__exec__.payload.__io_results__.call_service",
                    "type": "exists"
                  },
                  "on_false": [
                    {
                      "params": {
                        "attr": "_patch_args.model",
                        "operation": "set",
                        "value": "__exec__.instruction.params.model"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_patch_args.system",
                        "operation": "set",
                        "value": "你生成的规则必须严格遵守core_eval.json规范，且只能针对参数阈值进行调整，不能删除或绕过现有的安全回滚规则。"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_patch_args.prompt_template",
                        "operation": "set",
                        "value": "你是EvoRule架构师。当前系统遇到故障：{{ alert }}。请根据标准EvoRule格式，生成一条新的branch规则来解决此问题。规则必须包含合法的domain和on_true/on_false分支。只输出纯JSON，不要包含任何解释。"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_patch_args.tpl_alert",
                        "operation": "set",
                        "value": "__exec__.payload.audit.evolve_request"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_patch_args.temperature",
                        "operation": "set",
                        "value": "0.2"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_patch_args.max_tokens",
                        "operation": "set",
                        "value": 600
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "args": "__exec__.payload._patch_args",
                        "io_type": "call_service",
                        "service_name": "llm_advisor"
                      },
                      "type": "io_request"
                    }
                  ],
                  "on_true": [
                    {
                      "params": {
                        "attr": "audit.generated_patch_raw",
                        "operation": "set",
                        "value": "__exec__.payload.__io_results__.call_service"
                      },
                      "type": "set"
                    }
                  ]
                },
                "type": "branch"
              }
            ]
          },
          "type": "branch"
        }
      ],
      "provenance": {
        "source": "API 收录"
      },
      "domain": "robot",
      "tags": [
        "yuanze",
        "robot"
      ],
      "dependencies": [
        {
          "rule_ref": "rule_body.io_request[llm_advisor]",
          "service_name": "llm_advisor"
        }
      ]
    },
    {
      "entry_id": "rule-hotload-patch",
      "rule_body": [
        {
          "params": {
            "domain": {
              "instruction_type": "hotload_patch",
              "type": "instruction"
            },
            "on_true": [
              {
                "params": {
                  "domain": {
                    "path": "payload.audit.sandbox_verdict.passed",
                    "type": "eq",
                    "value": true
                  },
                  "on_false": [
                    {
                      "params": {
                        "attr": "audit.evolve_request",
                        "operation": "set",
                        "value": null
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.evolution_count",
                        "operation": "add",
                        "value": 1
                      },
                      "type": "set"
                    }
                  ],
                  "on_true": [
                    {
                      "params": {
                        "domain": {
                          "path": "__exec__.payload.__io_results__.call_service",
                          "type": "exists"
                        },
                        "on_false": [
                          {
                            "params": {
                              "attr": "_persist_args.operation",
                              "operation": "set",
                              "value": "append_transform"
                            },
                            "type": "set"
                          },
                          {
                            "params": {
                              "attr": "_persist_args.rule",
                              "operation": "set",
                              "value": "__exec__.payload.audit.generated_patch_raw"
                            },
                            "type": "set"
                          },
                          {
                            "params": {
                              "args": "__exec__.payload._persist_args",
                              "io_type": "call_service",
                              "service_name": "config_persist"
                            },
                            "type": "io_request"
                          }
                        ],
                        "on_true": [
                          {
                            "params": {
                              "attr": "audit.evolution_history.last_patch",
                              "operation": "set",
                              "value": "__exec__.payload.audit.generated_patch_raw"
                            },
                            "type": "set"
                          },
                          {
                            "params": {
                              "attr": "audit.evolution_history.reason",
                              "operation": "set",
                              "value": "__exec__.payload.audit.evolve_request.reason"
                            },
                            "type": "set"
                          },
                          {
                            "params": {
                              "attr": "audit.evolution_history.timestamp",
                              "operation": "set",
                              "value": "__exec__.instruction.params.timestamp"
                            },
                            "type": "set"
                          },
                          {
                            "params": {
                              "attr": "audit.evolve_request",
                              "operation": "set",
                              "value": null
                            },
                            "type": "set"
                          },
                          {
                            "params": {
                              "attr": "audit.evolution_count",
                              "operation": "add",
                              "value": 1
                            },
                            "type": "set"
                          }
                        ]
                      },
                      "type": "branch"
                    }
                  ]
                },
                "type": "branch"
              }
            ]
          },
          "type": "branch"
        }
      ],
      "provenance": {
        "source": "API 收录"
      },
      "domain": "robot",
      "tags": [
        "yuanze",
        "robot"
      ],
      "dependencies": [
        {
          "rule_ref": "rule_body.io_request[config_persist]",
          "service_name": "config_persist"
        }
      ]
