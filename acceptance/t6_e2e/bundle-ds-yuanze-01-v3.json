                  ],
                  "on_true": [
                    {
                      "params": {
                        "attr": "audit.pending_alert",
                        "operation": "set",
                        "value": null
                      },
                      "type": "set"
                    }
                  ]
                },
                "type": "branch"
              }
            ]
