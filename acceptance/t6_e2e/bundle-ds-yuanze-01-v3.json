            "on_true": [
              {
                "params": {
                  "domain": {
                    "path": "__exec__.payload.__io_results__.call_service",
                    "type": "exists"
                  },
                  "on_false": [
                    {
                      "params": {
                        "attr": "_sandbox_args.candidate_rule",
                        "operation": "set",
