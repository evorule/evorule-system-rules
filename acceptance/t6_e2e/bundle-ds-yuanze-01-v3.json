  "entries": [
    {
      "entry_id": "rule-audit-alert",
      "rule_body": [
        {
          "params": {
            "domain": {
              "instruction_type": "audit_alert",
              "type": "instruction"
            },
            "on_true": [
              {
                "params": {
                  "domain": {
                    "path": "__exec__.payload.__io_results__.call_service",
                    "type": "exists"
                  },
                  "on_false": [
                    {
                      "params": {
                        "attr": "_llm_args.model",
                        "operation": "set",
                        "value": "__exec__.instruction.params.model"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_llm_args.tpl_alert",
                        "operation": "set",
                        "value": "__exec__.payload.audit.pending_alert"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "_llm_args.tpl_snapshot",
                        "operation": "set",
                        "value": "__exec__.payload.audit.input_snapshot"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "args": "__exec__.payload._llm_args",
                        "io_type": "call_service",
                        "service_name": "llm_advisor"
                      },
                      "type": "io_request"
                    }
                  ],
                  "on_true": [
                    {
                      "params": {
                        "attr": "alert_sent",
                        "operation": "set",
                        "value": true
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.alert_llm_suggestion",
                        "operation": "set",
                        "value": "__exec__.payload.__io_results__.call_service"
                      },
                      "type": "set"
                    }
                  ]
                },
                "type": "branch"
              }
            ]
          },
          "type": "branch"
        }
      ],
      "provenance": {
        "source": "API 收录"
      },
      "domain": "robot",
      "tags": [
        "yuanze",
        "robot"
      ],
      "dependencies": [
        {
          "rule_ref": "rule_body.io_request[llm_advisor]",
          "service_name": "llm_advisor"
        }
      ]
    },
    {
      "entry_id": "rule-audit-compactor",
      "rule_body": [
        {
          "params": {
            "domain": {
              "instruction_type": "audit_compactor",
              "type": "instruction"
            },
            "on_true": [
              {
                "params": {
                  "domain": {
                    "path": "__exec__.payload.audit.compacted_log",
                    "type": "exists"
                  },
                  "on_false": [
                    {
                      "params": {
                        "attr": "audit.compacted_log.init_audit",
                        "operation": "set",
                        "value": "__exec__.instruction.params.timestamp"
                      },
                      "type": "set"
                    }
                  ],
                  "on_true": [
                    {
                      "params": {
                        "attr": "audit.compacted_log.last_audit",
                        "operation": "set",
                        "value": "__exec__.instruction.params.timestamp"
                      },
                      "type": "set"
                    },
                    {
                      "params": {
                        "attr": "audit.compacted_log.counter",
                        "operation": "set",
                        "value": "__exec__.payload.audit.counter"
                      },
                      "type": "set"
                    }
                  ]
                },
                "type": "branch"
              },
              {
                "params": {
                  "attr": "audit.input_snapshot",
                  "operation": "set",
                  "value": null
                },
                "type": "set"
              },
              {
                "params": {
                  "attr": "audit.pending_alert",
                  "operation": "set",
                  "value": null
                },
                "type": "set"
              }
            ]
          },
          "type": "branch"
        }
      ],
      "provenance": {
        "source": "API 收录"
      },
      "domain": "robot",
      "tags": [
        "yuanze",
        "robot"
      ]
    },
