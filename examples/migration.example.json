{
  "$schema": "https://evorule.org/schemas/migration/v1.0.json",
  "kind": "migration",
  "id": "com.evorule.migration.v0_to_v1_0_add_meta",
  "version": "1.0.0",
  "from_version": "v0.0",
  "to_version": "v1.0",
  "metadata": {
    "title": "v0 → v1.0 添加 5 顶层字段（引擎原生 transform）",
    "description": "为旧 evorule JSON 添加 $schema / kind / id / version / metadata 字段。v1.0 起 transform 用引擎原生语言（D3 对齐自举）：迁移目标 JSON 文档作为 __exec__.payload 加载，合成一条 {type: migrate} 指令触发；branch+instruction 域匹配，set 改值。废弃 v0.9 的 when:missing/present + then:set 伪 DSL。",
    "authors": ["evorulelab@gmail.com"],
    "created": "2026-08-23",
    "updated": "2026-08-23",
    "tags": ["migration", "v0_0", "v1_0"],
    "license": "AGPL-3.0-or-later"
  },
  "transform": [
    {
      "type": "branch",
      "params": {
        "domain": { "type": "instruction", "instruction_type": "migrate" },
        "on_true": [
          { "type": "set", "params": { "attr": "__exec__.payload.$schema", "operation": "set", "value": "__exec__.instruction.params.schema_uri" } },
          { "type": "set", "params": { "attr": "__exec__.payload.kind", "operation": "set", "value": "__exec__.instruction.params.kind" } },
          { "type": "set", "params": { "attr": "__exec__.payload.id", "operation": "set", "value": "__exec__.instruction.params.id" } },
          { "type": "set", "params": { "attr": "__exec__.payload.version", "operation": "set", "value": "__exec__.instruction.params.version" } },
          { "type": "set", "params": { "attr": "__exec__.payload.metadata", "operation": "set", "value": "__exec__.instruction.params.metadata" } }
        ],
        "on_false": []
      }
    }
  ]
}
