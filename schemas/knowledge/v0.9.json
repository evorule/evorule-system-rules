{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorule.org/schemas/knowledge/v0.9.json",
  "title": "evorule knowledge v0.9",
  "description": "知识库条目(对应 PITFALLS.json,或任何 RAG 文档集合)",
  "x_legal_authority_notice": "本 schema 由 EvoRule 团队维护,以 CC0 1.0 公共领域奉献(见 schemas/LICENSE-SCHEMAS.md);通过本 schema 校验或创作的 system JSON 内容 IP 归作者所有,evorule 不主张。详见 ../../LEGAL_NOTES.md 与 ../../docs/adr/scope-split-ip-model.md",
  "allOf": [
    { "$ref": "../_meta/v0.9.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "knowledge" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      },
      "required": ["entries"]
    }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "severity": {
          "enum": ["info", "warning", "error", "critical"]
        },
        "related": {
          "type": "array",
          "items": { "type": "string" },
          "description": "相关条目 ID"
        },
        "embedding_ref": {
          "type": "string",
          "description": "embedding 存储引用(可选)"
        }
      }
    }
  }
}
