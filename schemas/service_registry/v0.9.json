{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorule.org/schemas/service_registry/v0.9.json",
  "title": "evorule service_registry v0.9",
  "description": "服务注册 / HTTP 路由(对应 evorule-server/service_registry.json)",
  "x_legal_authority_notice": "本 schema 由 EvoRule 团队维护,以 CC0 1.0 公共领域奉献(见 schemas/LICENSE-SCHEMAS.md);通过本 schema 校验或创作的 system JSON 内容 IP 归作者所有,evorule 不主张。详见 ../../LEGAL_NOTES.md 与 ../../docs/adr/scope-split-ip-model.md",
  "allOf": [
    { "$ref": "../_meta/v0.9.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "service_registry" },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/service" }
        }
      },
      "required": ["services"]
    }
  ],
  "$defs": {
    "service": {
      "type": "object",
      "required": ["name", "endpoint"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "endpoint": { "type": "string", "format": "uri" },
        "method": {
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "WS"]
        },
        "auth": {
          "enum": ["none", "api_key", "oauth2", "mtls", "internal"]
        },
        "rate_limit": {
          "type": "integer",
          "minimum": 0,
          "description": "每秒请求数上限,0 = 无限"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
