{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorule.org/schemas/migration/v0.9.json",
  "title": "evorule migration v0.9",
  "description": "$schema 升级迁移规则(自举核心:migration 规则本身也被 evorule-system-rules 治理)",
  "x_legal_authority_notice": "本 schema 由 EvoRule 团队维护,以 CC0 1.0 公共领域奉献(见 schemas/LICENSE-SCHEMAS.md);通过本 schema 校验或创作的 system JSON 内容 IP 归作者所有,evorule 不主张。详见 ../../LEGAL_NOTES.md 与 ../../docs/adr/scope-split-ip-model.md",
  "allOf": [
    { "$ref": "../_meta/v0.9.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "migration" },
        "from_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+$",
          "description": "起始 $schema 版本"
        },
        "to_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+$",
          "description": "目标 $schema 版本"
        },
        "transforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transform" }
        }
      },
      "required": ["from_version", "to_version", "transforms"]
    }
  ],
  "$defs": {
    "transform": {
      "type": "object",
      "required": ["id", "when", "then"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M\\d{3,6}$",
          "description": "transform ID,migration 内唯一"
        },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "when": {
          "type": "object",
          "description": "evorule when 表达式",
          "additionalProperties": true
        },
        "then": {
          "type": "object",
          "description": "evorule then 表达式",
          "additionalProperties": true
        }
      }
    }
  }
}
