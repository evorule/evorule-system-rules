{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorule.org/schemas/workflow_dag/v0.9.json",
  "title": "evorule workflow_dag v0.9",
  "description": "DAG workflow 定义(对应 evo-agent/rules/workflows/*.json)",
  "x_legal_authority_notice": "本 schema 由 EvoRule 团队维护,以 CC0 1.0 公共领域奉献(见 schemas/LICENSE-SCHEMAS.md);通过本 schema 校验或创作的 system JSON 内容 IP 归作者所有,evorule 不主张。详见 ../../LEGAL_NOTES.md 与 ../../docs/adr/scope-split-ip-model.md",
  "allOf": [
    { "$ref": "../_meta/v0.9.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "workflow_dag" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      },
      "required": ["nodes"]
    }
  ],
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "type": {
          "enum": ["task", "decision", "fork", "join", "agent_invocation", "rule_invocation", "service_call"]
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "condition": {
          "type": "string",
          "description": "边的条件表达式(可选)"
        }
      }
    }
  }
}
